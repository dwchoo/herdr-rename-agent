#!/bin/sh
set -eu
script_path=$(readlink -f -- "$0")
plugin_root=$(dirname -- "$(dirname -- "$script_path")")
if [ ! -x "$plugin_root/.venv/bin/python" ] || ! "$plugin_root/.venv/bin/python" -c 'import tomlkit, prompt_toolkit, wcwidth; assert (tomlkit.__version__, prompt_toolkit.__version__, wcwidth.__version__) == ("0.15.1", "3.0.52", "0.2.13")' >/dev/null 2>&1; then
    "$plugin_root/bin/setup"
fi
export PYTHONPATH="$plugin_root/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$plugin_root/.venv/bin/python" -m herdr_agent_rename.installation "$@"
